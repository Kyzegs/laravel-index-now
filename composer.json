{
    "name": "kyzegs/laravel-index-now",
    "description": "Tell search engines about changed pages through the IndexNow protocol.",
    "keywords": [
        "indexnow",
        "laravel",
        "seo",
        "search engines",
        "bing",
        "yandex"
    ],
    "homepage": "https://github.com/Kyzegs/laravel-index-now",
    "license": "MIT",
    "authors": [
        {
            "name": "Sebastiaan",
            "homepage": "https://kyzegs.com",
            "role": "Developer"
        },
        {
            "name": "Bas",
            "email": "info@laravel-freelancer.nl",
            "role": "Original author"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-simplexml": "*",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/log": "^11.0 || ^12.0 || ^13.0",
        "illuminate/queue": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.23 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.1",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "phpmd/phpmd": "^2.14",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Kyzegs\\IndexNow\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kyzegs\\IndexNow\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "rector": "vendor/bin/rector process",
        "rector:dry": "vendor/bin/rector process --dry-run",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kyzegs\\IndexNow\\IndexNowServiceProvider"
            ],
            "aliases": {
                "IndexNow": "Kyzegs\\IndexNow\\Facades\\IndexNow"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
